    m_EntityBudgetCost { SCR_EntityBudgetValue "{D561AD08932E8501}" { m_BudgetType CAMPAIGN m_Value 1800 } }
    Description "Twin 35 mm guns with optical follow, night view, sight ranging and native rearm, refuel and repair. Radar deployment is visual only. Ranging does not adjust elevation; stabilization is unavailable. Multiplayer and operation on slopes require further validation."
   }
  }
 }
}


